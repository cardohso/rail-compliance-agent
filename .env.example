# Copy to .env and fill in locally. Never commit .env.

# --- Agent LLM (free tiers, no card) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# "gemini" (default) or "groq"
AGENT_PROVIDER=gemini
# Optional model override (empty = provider default)
AGENT_MODEL=

# --- How search_regulation reaches the rail assistant ---
# "local" (rail_rag retrieval in-process, no LLM, default), "live" (POST /ask), "replay" (recorded)
SEARCH_BACKEND=local
# local: the rail-regulation-rag data folder (processed corpus, sources.yaml, built index)
RAIL_RAG_DATA_DIR=../rail-regulation-rag/data
# live: base URL of a rail-regulation-rag deployment
RAIL_API_URL=https://rail-rag.calmcliff-0073b8b6.switzerlandnorth.azurecontainerapps.io
# Disk cache for search results (a re-run costs no retrieval and no live calls)
SEARCH_CACHE_DIR=eval/.cache/search
