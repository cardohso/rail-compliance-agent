{
  "id": "h01",
  "title": "400 m high-speed unit, compliant",
  "tags": [
    "heldout",
    "baseline",
    "high-speed",
    "length-dependent"
  ],
  "why": "A 400 m unit sits in the top table row, and at 320 km/h only the 800 mm door rule applies.",
  "spec": {
    "spec_version": "1",
    "name": "400 m high-speed unit, compliant",
    "unit_length_m": 400.0,
    "length_includes_power_head": false,
    "design_speed_kmh": 320.0,
    "wheelchair_spaces": 4,
    "exterior_doors": {
      "clear_width_mm": 850.0,
      "wheelchair_door_clear_width_mm": 850.0,
      "wheelchair_door_level_access": true
    },
    "steps": {
      "external_step_height_mm": 220.0,
      "internal_step_height_mm": 190.0
    },
    "toilets": {
      "fitted": 4,
      "universal": 2,
      "universal_door_clear_width_mm": 900.0
    }
  },
  "expected": {
    "wheelchair_spaces": {
      "verdict": "pass",
      "required": "≥ 4 (over 300 m row)",
      "gold_passages": [
        "tsi-prm:Annex §4.2.2.2#1"
      ],
      "expected_tools": [
        "search_regulation",
        "extract_requirement",
        "check"
      ],
      "alt_tools": [],
      "rationale": "Table 5 of point 4.2.2.2(1): 400 m is 'More than 300 metres' (4 spaces); 4 ≥ 4."
    },
    "exterior_doors.clear_width_mm": {
      "verdict": "pass",
      "required": "≥ 800 mm",
      "gold_passages": [
        "tsi-prm:Annex §4.2.2.3.2#1"
      ],
      "expected_tools": [
        "search_regulation",
        "extract_requirement",
        "check"
      ],
      "alt_tools": [],
      "rationale": "4.2.2.3.2(1): 850 ≥ 800."
    },
    "exterior_doors.wheelchair_door_clear_width_mm": {
      "verdict": "pass",
      "required": "≥ 800 mm (the 1000 mm rule needs a speed below 250)",
      "gold_passages": [
        "tsi-prm:Annex §4.2.2.3.2#1"
      ],
      "expected_tools": [
        "search_regulation",
        "extract_requirement",
        "check"
      ],
      "alt_tools": [],
      "rationale": "4.2.2.3.2(2) is for 'lower than 250 km/h'; at 320 km/h only (1) applies: 850 ≥ 800."
    },
    "steps.external_step_height_mm": {
      "verdict": "pass",
      "required": "≤ 230 mm",
      "gold_passages": [
        "tsi-prm:Annex §4.2.2.11.2#1"
      ],
      "expected_tools": [
        "search_regulation",
        "extract_requirement",
        "check"
      ],
      "alt_tools": [],
      "rationale": "4.2.2.11.2(5): 220 ≤ 230."
    },
    "steps.internal_step_height_mm": {
      "verdict": "pass",
      "required": "≤ 200 mm",
      "gold_passages": [
        "tsi-prm:Annex §4.2.2.11.2#1"
      ],
      "expected_tools": [
        "search_regulation",
        "extract_requirement",
        "check"
      ],
      "alt_tools": [],
      "rationale": "4.2.2.11.2(2): 190 ≤ 200."
    },
    "toilets.universal": {
      "verdict": "pass",
      "required": "≥ 1 when toilets are fitted",
      "gold_passages": [
        "tsi-prm:Annex §4.2.2.5#1"
      ],
      "expected_tools": [
        "search_regulation",
        "extract_requirement",
        "check"
      ],
      "alt_tools": [],
      "rationale": "4.2.2.5(1): 4 toilets fitted, 2 universal."
    },
    "toilets.universal_door_clear_width_mm": {
      "verdict": "pass",
      "required": "≥ 800 mm",
      "gold_passages": [
        "tsi-prm:Annex §5.3.2.4#1"
      ],
      "expected_tools": [
        "search_regulation",
        "extract_requirement",
        "check"
      ],
      "alt_tools": [],
      "rationale": "5.3.2.4(3): 900 ≥ 800."
    }
  }
}
